# ─────────────────────────────────────────────────────────────
# Переменные окружения BOW WOW COLLAR
# Скопируйте файл в .env.local и заполните. Без них сайт работает,
# но заказы не сохраняются между перезапусками и не приходят
# уведомления.
# ─────────────────────────────────────────────────────────────

# Хранилище заказов — Upstash Redis (бесплатный тариф, upstash.com).
# Проще всего подключить на Vercel: Storage → Upstash for Redis. Тогда
# Vercel сам создаст KV_REST_API_URL и KV_REST_API_TOKEN — сайт их понимает,
# и две строки ниже можно не заполнять.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Уведомление о заказе в Telegram.
# TELEGRAM_BOT_TOKEN — выдаёт @BotFather.
# TELEGRAM_CHAT_ID — id вашего чата с ботом.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Письмо клиенту о принятом заказе (resend.com)
RESEND_API_KEY=
ORDER_EMAIL_FROM="BOW WOW COLLAR <orders@bowwow.by>"

# Оплата. manual — заказ уходит менеджеру без онлайн-оплаты.
# bepaid — включает эквайринг, нужны shop_id и secret_key из личного кабинета.
PAYMENT_PROVIDER=manual
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
BEPAID_TEST_MODE=true

# Публичный адрес сайта — нужен для ссылок возврата после оплаты
NEXT_PUBLIC_SITE_URL=http://localhost:3000
